<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_type)">
  <!-- Single entry point for every Flexiv robot model. 'robot_type' values:

    Single arm on a mount (one robot_sn):
      Enlight-L, Rizon4, Rizon4s, Rizon4M, Rizon4R, Rizon10, Rizon10s
    One robot with two arms (one robot_sn):
      Enlight-LL   dual arm on world
      MICO-Core    fixed torso + two Enlight-L arms
      MICO-Plus    2-DOF pan-tilt torso + two Enlight-L arms
      MICO-Ultra   2-DOF waist torso on mobile base + two Enlight-L arms
    Single arm on an external axis (one robot_sn, use 'arm_type' to pick the arm):
      AICO1-4-V1, AICO1-4-V2
    Two paired robots (robot_sn_left + robot_sn_right, 'arm_type_left/right'):
      Rizon-Dual   two arms on a shared mount, no external axis
      AICO2-4-V1, AICO2-4-V2, AICO2-10-V1
  -->
  <xacro:arg name="robot_type" default="Enlight-L" />

  <material name="flexiv_black">
    <color rgba="0.22 0.22 0.22 1" />
  </material>

  <!-- import model macro -->
  <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv_common.xacro" />
  <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv_robot.xacro" />

  <!-- parameters -->
  <xacro:arg name="arm_prefix" default="" />
  <xacro:arg name="robot_sn" default="" />
  <xacro:arg name="joint_limits_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/joint_limits.yaml" />
  <!-- Empty means 'use the arm's default_kinematics.yaml'. -->
  <xacro:arg name="kinematics_parameters_file" default="" />
  <xacro:arg name="inertia_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/inertia_parameters.yaml" />
  <xacro:arg name="visual_parameters_file"
    default="$(find flexiv_description)/config/$(arg robot_type)/visual_parameters.yaml" />
  <xacro:arg name="load_gripper" default="false" />
  <xacro:arg name="gripper_name" default="Flexiv-GN01" />
  <xacro:arg name="load_mounted_ft_sensor" default="false" />
  <xacro:arg name="mounting_file" default="$(find flexiv_description)/config/single_robot_mounting.yaml" />
  <xacro:arg name="dual_mounting_file" default="$(find flexiv_description)/config/dual_robot_mounting.yaml" />
  <xacro:arg name="paired_mounting_file" default="$(find flexiv_description)/config/dual_arm_mounting.yaml" />

  <!-- External axis (AICO) parameters -->
  <xacro:arg name="external_axis_prefix" default="" />
  <!-- Arm carried by an external axis. -->
  <xacro:arg name="arm_type" default="" />

  <!-- Paired-robot parameters. Only read by Rizon-Dual and AICO2 configurations. -->
  <xacro:arg name="robot_sn_left" default="" />
  <xacro:arg name="robot_sn_right" default="" />
  <xacro:arg name="arm_type_left" default="" />
  <xacro:arg name="arm_type_right" default="" />
  <xacro:arg name="load_gripper_left" default="false" />
  <xacro:arg name="load_gripper_right" default="false" />
  <xacro:arg name="gripper_name_left" default="Flexiv-GN01" />
  <xacro:arg name="gripper_name_right" default="Flexiv-GN01" />
  <xacro:arg name="load_mounted_ft_sensor_left" default="false" />
  <xacro:arg name="load_mounted_ft_sensor_right" default="false" />
  <!-- Empty means 'use the arm's default_kinematics.yaml'. -->
  <xacro:arg name="kinematics_parameters_file_left" default="" />
  <xacro:arg name="kinematics_parameters_file_right" default="" />

  <!-- Boolean flags for dispatch -->
  <xacro:property name="robot_type_str" value="$(arg robot_type)" />
  <xacro:property name="is_mico_core" value="${robot_type_str == 'MICO-Core'}" />
  <xacro:property name="is_mico_plus" value="${robot_type_str == 'MICO-Plus'}" />
  <xacro:property name="is_mico_ultra" value="${robot_type_str == 'MICO-Ultra'}" />
  <xacro:property name="is_mico" value="${is_mico_core or is_mico_plus or is_mico_ultra}" />
  <xacro:property name="is_enlight_ll" value="${robot_type_str == 'Enlight-LL'}" />
  <xacro:property name="is_dual" value="${is_enlight_ll or is_mico}" />

  <xacro:property name="is_aico1" value="${robot_type_str in ['AICO1-4-V1', 'AICO1-4-V2']}" />
  <xacro:property name="is_aico2"
    value="${robot_type_str in ['AICO2-4-V1', 'AICO2-4-V2', 'AICO2-10-V1']}" />
  <xacro:property name="is_rizon_dual" value="${robot_type_str == 'Rizon-Dual'}" />
  <!-- 'Paired' means two robots with two serial numbers, as opposed to one robot
       with two arms. They need different hardware interfaces. -->
  <xacro:property name="is_paired" value="${is_rizon_dual or is_aico2}" />

  <!-- The external axis macro name is the robot type lowercased with dashes as
       underscores, e.g. AICO2-10-V1 -> aico2_10_v1. The hardware interface takes
       the same string as its 'external_axis_type' parameter. -->
  <xacro:property name="external_axis_type"
    value="${robot_type_str.lower().replace('-', '_') if (is_aico1 or is_aico2) else ''}" />

  <!-- Anything without a dedicated branch below is a plain single arm on a mount. -->
  <xacro:property name="is_single" value="${not (is_dual or is_paired or is_aico1)}" />

  <xacro:property name="cfg" value="$(find flexiv_description)/config" />

  <!-- ============================== SINGLE ARM ON A MOUNT ============================== -->
  <xacro:if value="${is_single}">
    <xacro:property name="mounting" value="${xacro.load_yaml('$(arg mounting_file)')}" />
    <xacro:property name="single_kinematics"
      value="${'$(arg kinematics_parameters_file)' if '$(arg kinematics_parameters_file)' != ''
               else cfg + '/' + robot_type_str + '/default_kinematics.yaml'}" />

    <xacro:flexiv_robot
      robot_type="$(arg robot_type)"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
      kinematics_parameters_file="${single_kinematics}"
      inertia_parameters_file="$(arg inertia_parameters_file)"
      visual_parameters_file="$(arg visual_parameters_file)"
      arm_prefix="$(arg arm_prefix)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      base_rpy="${radians(mounting['orientation']['rx'])} ${radians(mounting['orientation']['ry'])} ${radians(mounting['orientation']['rz'])}">
    </xacro:flexiv_robot>
  </xacro:if>

  <!-- ============================== DUAL ARM (Enlight-LL) ============================== -->
  <xacro:if value="${is_enlight_ll}">

    <xacro:property name="dual_mounting" value="${xacro.load_yaml('$(arg dual_mounting_file)')}" />
    <xacro:property name="left_pose" value="${dual_mounting['positions']['left']}" />
    <xacro:property name="right_pose" value="${dual_mounting['positions']['right']}" />

    <!-- Each arm of a dual-arm product is an Enlight-L: reuse its config + meshes for both arms. -->
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <!-- Kinematics are per-robot and live in this product's own file, one section per arm. -->
    <xacro:property name="ll_kinematics_file"
      value="$(find flexiv_description)/config/Enlight-LL/default_kinematics.yaml" />

    <!-- Left arm: owns the shared world link + its base joint. -->
    <xacro:flexiv_robot
      robot_type="Enlight-L"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${ll_kinematics_file}"
      kinematics_section="ARM_1"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="left"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      add_world_link="true"
      create_base_joint="true"
      base_xyz="${left_pose['x']} ${left_pose['y']} ${left_pose['z']}"
      base_rpy="${radians(left_pose['rx'])} ${radians(left_pose['ry'])} ${radians(left_pose['rz'])}">
    </xacro:flexiv_robot>

    <!-- Right arm: reuses the world link created by the left arm. -->
    <xacro:flexiv_robot
      robot_type="Enlight-L"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${ll_kinematics_file}"
      kinematics_section="ARM_2"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="right"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      add_world_link="false"
      create_base_joint="true"
      base_xyz="${right_pose['x']} ${right_pose['y']} ${right_pose['z']}"
      base_rpy="${radians(right_pose['rx'])} ${radians(right_pose['ry'])} ${radians(right_pose['rz'])}">
    </xacro:flexiv_robot>

    <xacro:compute_arm_prefix arm_prefix="left" robot_sn="$(arg robot_sn)" />
    <xacro:property name="ll_prefix_left" value="${computed_arm_prefix}" lazy_eval="false" />
    <xacro:compute_arm_prefix arm_prefix="right" robot_sn="$(arg robot_sn)" />
    <xacro:property name="ll_prefix_right" value="${computed_arm_prefix}" lazy_eval="false" />

  </xacro:if>

  <!-- ============================== MICO-Core ============================== -->
  <xacro:if value="${is_mico_core}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_core.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_core
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      />
  </xacro:if>

  <!-- ============================== MICO-Plus ============================== -->
  <xacro:if value="${is_mico_plus}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_plus.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_plus
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      />
  </xacro:if>

  <!-- ============================== MICO-Ultra ============================== -->
  <xacro:if value="${is_mico_ultra}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/mico_ultra.xacro" />
    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <xacro:mico_ultra
      robot_sn="$(arg robot_sn)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      />
  </xacro:if>

  <!-- ================= AICO1: single arm on a 2-DOF external axis ================= -->
  <xacro:if value="${is_aico1}">
    <xacro:include filename="$(find flexiv_description)/urdf/common/aico1_4_v1.xacro" />
    <xacro:include filename="$(find flexiv_description)/urdf/common/aico1_4_v2.xacro" />

    <xacro:property name="aico1_arm" value="${'$(arg arm_type)' if '$(arg arm_type)' != '' else 'Rizon4'}" />
    <xacro:unless value="${aico1_arm in ['Rizon4', 'Rizon4s', 'Rizon4R']}">
      ${xacro.warning('AICO1 supports Rizon4, Rizon4s and Rizon4R. You selected ' + aico1_arm + '.')}
    </xacro:unless>

    <!-- The external axis owns the world link; its adapter joint parents the arm. -->
    <link name="world" />
    <xacro:property name="aico1_base"
      value="$(arg external_axis_prefix)${external_axis_type}_base_link" />
    <joint name="world_to_platform" type="fixed">
      <parent link="world" />
      <child link="${aico1_base}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Must match the prefix flexiv_robot derives for this arm. -->
    <xacro:compute_arm_prefix arm_prefix="$(arg arm_prefix)" robot_sn="$(arg robot_sn)" />
    <xacro:property name="aico1_arm_prefix" value="${computed_arm_prefix}" lazy_eval="false" />

    <xacro:if value="${robot_type_str == 'AICO1-4-V1'}">
      <xacro:aico1_4_v1 prefix="$(arg external_axis_prefix)"
        arm_prefix="${aico1_arm_prefix}"
        mesh_prefix_path="package://flexiv_description/" />
    </xacro:if>
    <xacro:if value="${robot_type_str == 'AICO1-4-V2'}">
      <xacro:aico1_4_v2 prefix="$(arg external_axis_prefix)"
        arm_prefix="${aico1_arm_prefix}"
        mesh_prefix_path="package://flexiv_description/" />
    </xacro:if>

    <xacro:property name="aico1_kinematics"
      value="${'$(arg kinematics_parameters_file)' if '$(arg kinematics_parameters_file)' != ''
               else cfg + '/' + aico1_arm + '/default_kinematics.yaml'}" />

    <xacro:flexiv_robot
      robot_type="${aico1_arm}"
      robot_sn="$(arg robot_sn)"
      joint_limits_parameters_file="${cfg}/${aico1_arm}/joint_limits.yaml"
      kinematics_parameters_file="${aico1_kinematics}"
      inertia_parameters_file="${cfg}/${aico1_arm}/inertia_parameters.yaml"
      visual_parameters_file="${cfg}/${aico1_arm}/visual_parameters.yaml"
      arm_prefix="$(arg arm_prefix)"
      load_gripper="$(arg load_gripper)"
      gripper_name="$(arg gripper_name)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)"
      add_world_link="false"
      create_base_joint="false" />
  </xacro:if>

  <!-- ========== PAIRED ROBOTS: Rizon-Dual and AICO2 (two serial numbers) ==========
       Two robots driven together, as opposed to Enlight-LL and MICO above which are
       one robot with two arms on a single robot_sn. -->
  <xacro:if value="${is_paired}">

    <!-- AICO2-10-V1 carries two Rizon10; the -4- variants carry a Rizon4 / Rizon4R
         mirrored pair, which is also the default for a plain Rizon-Dual. -->
    <xacro:property name="paired_default_left"
      value="${'Rizon10' if robot_type_str == 'AICO2-10-V1' else 'Rizon4'}" />
    <xacro:property name="paired_default_right"
      value="${'Rizon10R' if robot_type_str == 'AICO2-10-V1' else 'Rizon4R'}" />
    <xacro:property name="arm_left"
      value="${'$(arg arm_type_left)' if '$(arg arm_type_left)' != '' else paired_default_left}" />
    <xacro:property name="arm_right"
      value="${'$(arg arm_type_right)' if '$(arg arm_type_right)' != '' else paired_default_right}" />

    <xacro:if value="${robot_type_str in ['AICO2-4-V1', 'AICO2-4-V2']}">
      <xacro:unless value="${arm_left in ['Rizon4', 'Rizon4s', 'Rizon4R'] and arm_right in ['Rizon4', 'Rizon4s', 'Rizon4R']}">
        ${xacro.warning(robot_type_str + ' carries Rizon4-class arms. You selected ' + arm_left + ' and ' + arm_right + '.')}
      </xacro:unless>
    </xacro:if>
    <xacro:if value="${robot_type_str == 'AICO2-10-V1'}">
      <xacro:unless value="${arm_left in ['Rizon10', 'Rizon10R'] and arm_right in ['Rizon10', 'Rizon10R']}">
        ${xacro.warning('AICO2-10-V1 carries Rizon10-class arms. You selected ' + arm_left + ' and ' + arm_right + '.')}
      </xacro:unless>
    </xacro:if>

    <!-- Must match the prefixes flexiv_robot derives, including when either serial
         number is empty. lazy_eval is off so each capture resolves before the next
         call. -->
    <xacro:compute_arm_prefix arm_prefix="left" robot_sn="$(arg robot_sn_left)" />
    <xacro:property name="prefix_left" value="${computed_arm_prefix}" lazy_eval="false" />
    <xacro:compute_arm_prefix arm_prefix="right" robot_sn="$(arg robot_sn_right)" />
    <xacro:property name="prefix_right" value="${computed_arm_prefix}" lazy_eval="false" />

    <link name="world" />

    <!-- AICO2: the external axis carries both arms, so neither creates a base joint. -->
    <xacro:if value="${is_aico2}">
      <xacro:include filename="$(find flexiv_description)/urdf/common/aico2_4_v1.xacro" />
      <xacro:include filename="$(find flexiv_description)/urdf/common/aico2_4_v2.xacro" />
      <xacro:include filename="$(find flexiv_description)/urdf/common/aico2_10_v1.xacro" />

      <joint name="world_to_platform" type="fixed">
        <parent link="world" />
        <child link="$(arg external_axis_prefix)${external_axis_type}_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
      </joint>

      <xacro:if value="${robot_type_str == 'AICO2-4-V1'}">
        <xacro:aico2_4_v1 prefix="$(arg external_axis_prefix)"
          left_arm_prefix="${prefix_left}" right_arm_prefix="${prefix_right}"
          mesh_prefix_path="package://flexiv_description/" />
      </xacro:if>
      <xacro:if value="${robot_type_str == 'AICO2-4-V2'}">
        <xacro:aico2_4_v2 prefix="$(arg external_axis_prefix)"
          left_arm_prefix="${prefix_left}" right_arm_prefix="${prefix_right}"
          mesh_prefix_path="package://flexiv_description/" />
      </xacro:if>
      <xacro:if value="${robot_type_str == 'AICO2-10-V1'}">
        <xacro:aico2_10_v1 prefix="$(arg external_axis_prefix)"
          left_arm_prefix="${prefix_left}" right_arm_prefix="${prefix_right}"
          mesh_prefix_path="package://flexiv_description/" />
      </xacro:if>

      <xacro:property name="paired_left_xyz" value="0.0 0.0 0.0" />
      <xacro:property name="paired_left_rpy" value="0.0 0.0 0.0" />
      <xacro:property name="paired_right_xyz" value="0.0 0.0 0.0" />
      <xacro:property name="paired_right_rpy" value="0.0 0.0 0.0" />
      <xacro:property name="paired_base_joint" value="false" />
    </xacro:if>

    <!-- Rizon-Dual: no external axis, so both arms bolt to the world at the poses
         given by the mounting file. -->
    <xacro:if value="${is_rizon_dual}">
      <xacro:property name="paired_mounting"
        value="${xacro.load_yaml('$(arg paired_mounting_file)')}" />
      <xacro:property name="pl" value="${paired_mounting['positions']['left']}" />
      <xacro:property name="pr" value="${paired_mounting['positions']['right']}" />
      <xacro:property name="paired_left_xyz" value="${pl['x']} ${pl['y']} ${pl['z']}" />
      <xacro:property name="paired_left_rpy"
        value="${radians(pl['rx'])} ${radians(pl['ry'])} ${radians(pl['rz'])}" />
      <xacro:property name="paired_right_xyz" value="${pr['x']} ${pr['y']} ${pr['z']}" />
      <xacro:property name="paired_right_rpy"
        value="${radians(pr['rx'])} ${radians(pr['ry'])} ${radians(pr['rz'])}" />
      <xacro:property name="paired_base_joint" value="true" />
    </xacro:if>

    <xacro:property name="paired_kinematics_left"
      value="${'$(arg kinematics_parameters_file_left)' if '$(arg kinematics_parameters_file_left)' != ''
               else cfg + '/' + arm_left + '/default_kinematics.yaml'}" />
    <xacro:property name="paired_kinematics_right"
      value="${'$(arg kinematics_parameters_file_right)' if '$(arg kinematics_parameters_file_right)' != ''
               else cfg + '/' + arm_right + '/default_kinematics.yaml'}" />

    <xacro:flexiv_robot
      robot_type="${arm_left}"
      robot_sn="$(arg robot_sn_left)"
      joint_limits_parameters_file="${cfg}/${arm_left}/joint_limits.yaml"
      kinematics_parameters_file="${paired_kinematics_left}"
      inertia_parameters_file="${cfg}/${arm_left}/inertia_parameters.yaml"
      visual_parameters_file="${cfg}/${arm_left}/visual_parameters.yaml"
      arm_prefix="left"
      load_gripper="$(arg load_gripper_left)"
      gripper_name="$(arg gripper_name_left)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor_left)"
      add_world_link="false"
      create_base_joint="${paired_base_joint}"
      base_xyz="${paired_left_xyz}"
      base_rpy="${paired_left_rpy}" />

    <xacro:flexiv_robot
      robot_type="${arm_right}"
      robot_sn="$(arg robot_sn_right)"
      joint_limits_parameters_file="${cfg}/${arm_right}/joint_limits.yaml"
      kinematics_parameters_file="${paired_kinematics_right}"
      inertia_parameters_file="${cfg}/${arm_right}/inertia_parameters.yaml"
      visual_parameters_file="${cfg}/${arm_right}/visual_parameters.yaml"
      arm_prefix="right"
      load_gripper="$(arg load_gripper_right)"
      gripper_name="$(arg gripper_name_right)"
      load_mounted_ft_sensor="$(arg load_mounted_ft_sensor_right)"
      add_world_link="false"
      create_base_joint="${paired_base_joint}"
      base_xyz="${paired_right_xyz}"
      base_rpy="${paired_right_rpy}" />
  </xacro:if>

</robot>
