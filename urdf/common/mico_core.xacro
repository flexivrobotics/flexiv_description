<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    MICO-Core: fixed torso (no actuated torso joints) with two Enlight-L arms.
    Arm joints: left_<robot_sn>_joint1..7, right_<robot_sn>_joint1..7.
    An empty robot_sn drops the separating underscore, e.g. 'torso_joint1', 'left_joint1'.
  -->

  <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv_common.xacro" />
  <xacro:include filename="$(find flexiv_description)/urdf/common/flexiv_robot.xacro" />

  <xacro:macro name="mico_core"
    params="
    robot_sn
    load_gripper:=false
    gripper_name:='Flexiv-GN01'
    load_mounted_ft_sensor:=false
    torso_joint_limits_file:='$(find flexiv_description)/config/MICO-Core/joint_limits.yaml'
    kinematics_parameters_file:='$(find flexiv_description)/config/MICO-Core/default_kinematics.yaml'
    torso_inertia_file:='$(find flexiv_description)/config/MICO-Core/inertia_parameters.yaml'
    torso_visual_file:='$(find flexiv_description)/config/MICO-Core/visual_parameters.yaml'
    ">

    <xacro:property name="arm_cfg" value="$(find flexiv_description)/config/Enlight-L" />
    <!-- Kinematics are per-robot and live in this product's own file, one section per
         chain. The rest of arm_cfg is model spec shared with a standalone Enlight-L. -->
    <!-- All prefixes follow the same rule as the arms: the separating underscore
         only appears when the part it separates is non-empty, so an empty robot_sn
         gives 'torso_base_link' rather than '_torso_base_link'. lazy_eval is off so
         each capture resolves before the next call. -->
    <xacro:compute_arm_prefix robot_sn="${robot_sn}" />
    <xacro:property name="sn_prefix" value="${computed_arm_prefix}" lazy_eval="false" />
    <xacro:property name="torso_prefix" value="${sn_prefix}torso_" lazy_eval="false" />
    <xacro:compute_arm_prefix arm_prefix="left" robot_sn="${robot_sn}" />
    <xacro:property name="prefix_left" value="${computed_arm_prefix}" lazy_eval="false" />
    <xacro:compute_arm_prefix arm_prefix="right" robot_sn="${robot_sn}" />
    <xacro:property name="prefix_right" value="${computed_arm_prefix}" lazy_eval="false" />

    <xacro:read_model_data
      joint_limits_parameters_file="${torso_joint_limits_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      kinematics_section="EXT_AXIS"
      inertia_parameters_file="${torso_inertia_file}"
      visual_parameters_file="${torso_visual_file}" />

    <!-- World link and fixed joint to torso base -->
    <link name="world" />

    <joint name="${torso_prefix}world_joint" type="fixed">
      <parent link="world" />
      <child link="${torso_prefix}base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Torso: MICO-Core base_link (fixed, no revolute joints) -->
    <link name="${torso_prefix}base_link">
      <inertial>
        <xacro:get_inertias name="base_link" />
      </inertial>
      <xacro:get_visuals name="base_link" />
      <xacro:get_collisions name="base_link" />
    </link>

    <!-- Torso flange links (massless) -->
    <link name="${torso_prefix}left_flange">
      <inertial>
        <mass value="0" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
      </inertial>
    </link>

    <link name="${torso_prefix}right_flange">
      <inertial>
        <mass value="0" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
      </inertial>
    </link>

    <!-- Fixed adapter joints: base_link -> flanges -->
    <joint name="${torso_prefix}left_arm_adapter" type="fixed">
      <xacro:get_kinematics name="left_arm_adapter" />
      <parent link="${torso_prefix}base_link" />
      <child link="${torso_prefix}left_flange" />
    </joint>

    <!-- Right adapter mirrors the left -->
    <joint name="${torso_prefix}right_arm_adapter" type="fixed">
      <xacro:get_kinematics name="right_arm_adapter" />
      <parent link="${torso_prefix}base_link" />
      <child link="${torso_prefix}right_flange" />
    </joint>

    <!-- Left arm (Enlight-L): no world link, no base joint (we attach it below) -->
    <xacro:flexiv_robot
      robot_type="Enlight-L"
      robot_sn="${robot_sn}"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${kinematics_parameters_file}"
      kinematics_section="ARM_1"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="left"
      load_gripper="${load_gripper}"
      gripper_name="${gripper_name}"
      load_mounted_ft_sensor="${load_mounted_ft_sensor}"
      add_world_link="false"
      create_base_joint="false"
    />

    <!-- Right arm (Enlight-L): no world link, no base joint -->
    <xacro:flexiv_robot
      robot_type="Enlight-L"
      robot_sn="${robot_sn}"
      joint_limits_parameters_file="${arm_cfg}/joint_limits.yaml"
      kinematics_parameters_file="${kinematics_parameters_file}"
      kinematics_section="ARM_2"
      inertia_parameters_file="${arm_cfg}/inertia_parameters.yaml"
      visual_parameters_file="${arm_cfg}/visual_parameters.yaml"
      arm_prefix="right"
      load_gripper="${load_gripper}"
      gripper_name="${gripper_name}"
      load_mounted_ft_sensor="${load_mounted_ft_sensor}"
      add_world_link="false"
      create_base_joint="false"
    />

    <!-- Attach arm base_links to torso flanges (identity: adapter joint already orients flange) -->
    <joint name="${torso_prefix}left_flange_to_left_arm" type="fixed">
      <parent link="${torso_prefix}left_flange" />
      <child link="${prefix_left}base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="${torso_prefix}right_flange_to_right_arm" type="fixed">
      <parent link="${torso_prefix}right_flange" />
      <child link="${prefix_right}base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

  </xacro:macro>

</robot>
