<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="aico2_platform_x2"
    params="prefix left_arm_prefix right_arm_prefix mesh_prefix_path">

    <joint name="${prefix}aico2_x2_joint1" type="revolute">
      <origin xyz="0 0 0.804" rpy="0 0 0" />
      <parent link="${prefix}aico2_x2_base_link" />
      <child link="${prefix}aico2_x2_link1" />
      <axis xyz="0 0 1" />
      <limit lower="-1.57" upper="1.57" effort="1000" velocity="1" />
    </joint>

    <joint name="${prefix}aico2_x2_joint2" type="revolute">
      <origin xyz="0 0 0.116" rpy="0 0 0" />
      <parent link="${prefix}aico2_x2_link1" />
      <child link="${prefix}aico2_x2_link2" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="1.57" effort="1900" velocity="1" />
    </joint>

    <joint name="${prefix}aico2_x2_left_arm_adapter" type="fixed">
      <origin xyz="0 -0.0375 0.33" rpy="-1.5708 1.5708 0" />
      <parent link="${prefix}aico2_x2_link2" />
      <child link="${left_arm_prefix}base_link" />
      <axis xyz="0 0 0" />
    </joint>

    <joint name="${prefix}aico2_x2_right_arm_adapter" type="fixed">
      <origin xyz="0 0.0375 0.33" rpy="1.5708 -1.5708 0" />
      <parent link="${prefix}aico2_x2_link2" />
      <child link="${right_arm_prefix}base_link" />
      <axis xyz="0 0 0" />
    </joint>

    <link name="${prefix}aico2_x2_base_link">
      <inertial>
        <origin xyz="-0.006 -0.00638 0.157" rpy="0 0 0" />
        <mass value="30.4" />
        <inertia ixx="0.67" ixy="-0.0021" ixz="0.006" iyy="0.65" iyz="0.0004" izz="1.13" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/visual/base_link.obj" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/collision/base_link.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}aico2_x2_link1">
      <inertial>
        <origin xyz="-0.00685 -0.00021 -0.073" rpy="0 0 0" />
        <mass value="3.3" />
        <inertia ixx="0.19" ixy="-9E-06" ixz="0.00231" iyy="0.12" iyz="0.00012" izz="0.083" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/visual/link1.obj" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/collision/link1.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}aico2_x2_link2">
      <inertial>
        <origin xyz="0.00217 3E-05 0.3" rpy="0 0 0" />
        <mass value="4" />
        <inertia ixx="0.167" ixy="6.9E-06" ixz="-0.00029" iyy="0.082" iyz="-3.7E-06" izz="0.125" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/visual/link2.obj" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_prefix_path}meshes/AICO2-X2/collision/link2.stl" />
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>
